# NEXUS Environment Configuration
# Fill in your actual credentials below

QUOTEX_EMAIL=your.email@example.com
QUOTEX_PASSWORD=your_password_here

# Trading Configuration
TRADING_MODE=demo
AUTO_LOGIN=true

# AI/ML Configuration
ENABLE_AI_MODELS=true
MODEL_TRAINING_ENABLED=false

# Risk Management
MAX_DAILY_LOSS=500.0
MAX_DRAWDOWN_PERCENT=20.0

# Logging
LOG_LEVEL=INFO
