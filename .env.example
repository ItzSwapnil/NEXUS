# NEXUS local configuration template.
# Copy to .env and add only values you need. Keep .env private and untracked.

# Quotex account credentials (optional; needed for broker-connected features)
QUOTEX_EMAIL=
QUOTEX_PASSWORD=

# Optional browser/session authentication values. These are secrets.
# Prefer the supported login flow; never commit real values here.
QUOTEX_COOKIES=
QUOTEX_SSID=
QUOTEX_USER_AGENT=
AUTO_LOGIN=false

# API authentication. Keep disabled for local-only use. If exposing the API,
# set a long random token and enable the requirement before starting the server.
NEXUS_API_REQUIRE_TOKEN=false
NEXUS_API_TOKEN=

# Optional named Cloudflare Tunnel. Configure the tunnel with Cloudflare first.
NEXUS_CLOUDFLARE_TUNNEL=

# Local diagnostics and reproducibility
NEXUS_LOG_LEVEL=INFO
NEXUS_ENGINE_RNG_SEED=42
