# NEXUS Configuration Template
# Copy this file to .env and fill in your actual credentials

# ============================================
# Broker Credentials (Quotex)
# ============================================
QUOTEX_EMAIL=your_quotex_email
QUOTEX_PASSWORD=your_password_here

# ============================================
# Trading Settings
# ============================================
TRADING_MODE=demo  # Options: demo, live
DEFAULT_ASSET=EURUSD
DEFAULT_EXPIRATION=60  # seconds
BASE_TRADE_AMOUNT=10.0

# ============================================
# Risk Management
# ============================================
MAX_RISK_PER_TRADE_PERCENT=2.0
MAX_DAILY_LOSS=100.0
MAX_DAILY_TRADES=50
ENABLE_KELLY_CRITERION=true

# ============================================
# AI Model Settings
# ============================================
LSTM_ENABLED=true
DQN_ENABLED=true
ENSEMBLE_ENABLED=true
MODEL_UPDATE_INTERVAL=3600  # seconds

# ============================================
# System Settings
# ============================================
LOG_LEVEL=INFO
ENABLE_GUI=true
AUTO_TRADE=false

# ============================================
# Advanced Settings
# ============================================
NEXUS_ENGINE_RNG_SEED=42
PAYOUT_THRESHOLD=80.0
EXPLORATION_EPSILON=0.1

