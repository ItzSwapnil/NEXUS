
# Copy this file to .env and fill in your credentials/session
# Auto-login toggle
AUTO_LOGIN=true

# Quotex credentials and options
QUOTEX__EMAIL=your_email@example.com
QUOTEX__PASSWORD=your_password
QUOTEX__DEMO_MODE=false
QUOTEX__LANG=en

# Optional: Browser-derived session for more reliable real balance/trading
# Paste your real browser User-Agent and full Cookie header (quoted if needed)
QUOTEX__USER_AGENT=
QUOTEX__COOKIES=
QUOTEX__SSID=

